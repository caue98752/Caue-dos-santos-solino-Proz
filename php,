<?php

class Calculadora {
    
    public function somar($num1, $num2) {
        return $num1 + $num2;
    }

    public function subtrair($num1, $num2) {
        return $num1 - $num2;
    }

    public function multiplicar($num1, $num2) {
        return $num1 * $num2;
    }

    public function dividir($num1, $num2) {
        if ($num2 == 0) {
            return "Erro: Não é possível dividir por zero!";
        }
        return $num1 / $num2;
    }
}

$calc = new Calculadora();

$a = 10;
$b = 5;

echo "Soma: " . $calc->somar($a, $b) . "\n";          
echo "Subtração: " . $calc->subtrair($a, $b) . "\n";
echo "Multiplicação: " . $calc->multiplicar($a, $b) . "\n"; 
echo "Divisão: " . $calc->dividir($a, $b) . "\n";     

echo "Divisão por zero: " . $calc->dividir($a, 0) . "\n"; 
?>
